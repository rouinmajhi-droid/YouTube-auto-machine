# ==========================================
# AI AUTOMATION - CONFIGURATION SETTINGS
# ==========================================

# Server
PORT=5000
NODE_ENV=development
# Local testing only; only takes effect with NODE_ENV=development.
# Keep false or unset except on a trusted local development server.
ADMIN_AUTH_BYPASS=false
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=4595ddefff0211da68f3c7a3ec989b73eef3445e4baf6d58531adf6f271ea717

# Required to persist admin integration keys and YouTube OAuth tokens encrypted at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=27df4b5dcd75190532336ddd6cb8e983884d1cb64e8f70a02c4b1256071d4f29
# Optional encrypted settings path (defaults to database/secure-settings.enc)
# SECURE_STORE_PATH=

# AI LLM Provider Keys (store provider secrets in a private environment/secret manager)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional server-side Claude key pool; separate keys with newlines in a private .env file
# or a deployment secret manager. Never commit live provider keys to source control.
ANTHROPIC_API_KEYS=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Gemini and video-generation API keys are saved per-user from Settings & integrations.

# YouTube OAuth (set the redirect URI to http://localhost:5000/api/youtube/callback)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/callback

# Database Configuration (Choose Supabase or Firebase)
# 1. Supabase (PostgreSQL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. Firebase / Firestore (Optional alternative)
FIREBASE_PROJECT_ID=aisdd-6f89e
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_DATABASE_URL=https://aisdd-6f89e-default-rtdb.firebaseio.com

# Offerwall Configurations
# BitLabs (Surveys & Tasks)
BITLABS_APP_TOKEN=
BITLABS_SECRET_KEY=
BITLABS_S2S_KEY=

# CPX Research (Surveys & Offers)
CPX_APP_ID=
CPX_SECURE_HASH=

# Payment Gateway Keys
# Razorpay (India & UPI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe (Global Cards)
STRIPE_SECRET_KEY=

# Dynamic UPI QR Code (Direct India UPI Transfers)
UPI_MERCHANT_VPA=
UPI_MERCHANT_NAME=

# Google AdSense
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_HEADER_SLOT=
GOOGLE_ADSENSE_FOOTER_SLOT=

# Wallet & Economy
# 10 Coins = 1 INR (5000 Coins = ₹500)
COINS_PER_INR=10
